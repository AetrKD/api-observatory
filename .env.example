GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 비공개 저장소용 GitHub App callback: SITE_URL/api/github/callback
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_SOURCE_TOKEN=
