# 서버 전용. 실제 비밀값은 동기화되지 않는 로컬 .env.local 또는 Vercel에 보관합니다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
